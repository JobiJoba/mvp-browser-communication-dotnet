@page "/messages-cache-server"
@rendermode InteractiveServer
@implements IDisposable
@using MvpDockerMessages.Web.Models
@using MvpDockerMessages.Web.Services
@inject MessagesApiClient Api
@inject MessagesListCache Cache
@inject MessagesServerSyncBus ServerBus

<PageTitle>Messages (cache server)</PageTitle>

<div class="messages-header">
    <div>
        <h1>Messages (cache server)</h1>
        <p>Click a row to open the detail in a <strong>new browser tab</strong>.</p>
        <p class="messages-reload-note">
            Same UX as <a href="messages-cache">/messages-cache</a>, but notify is
            <strong>server-side C#</strong>: an in-process <code>MessagesServerSyncBus</code>
            fans out across Blazor circuits on this Web host (no <code>BroadcastChannel</code>).
            Overview keeps a circuit-scoped cache and patches one row on Save.
        </p>
    </div>
</div>

@if (_error is not null)
{
    <p class="messages-error">@_error</p>
}
else if (Cache.Items is null)
{
    <p>Loading…</p>
}
else if (Cache.Items.Count == 0)
{
    <p>No messages.</p>
}
else
{
    <div class="message-list" role="list">
        @foreach (var message in Cache.Items)
        {
            <a class="message-row"
               href="messages-cache-server/@message.Id"
               target="_blank"
               rel="noopener"
               role="listitem">
                <div class="message-row-main">
                    <span class="message-subject">@message.Subject</span>
                    <span class="message-preview">@Truncate(message.Body, 80)</span>
                </div>
                <span class="state-badge state-@message.State.ToString().ToLowerInvariant()">
                    @FormatState(message.State)
                </span>
            </a>
        }
    </div>
}

@code {
    private readonly string _subscriberId = Guid.NewGuid().ToString("N");
    private string? _error;
    private IDisposable? _subscription;

    protected override async Task OnInitializedAsync()
    {
        Cache.Changed += OnCacheChanged;
        _subscription = ServerBus.Subscribe(_subscriberId, OnServerMessageUpdated);
        try
        {
            await Cache.EnsureLoadedAsync(Api);
        }
        catch (Exception ex)
        {
            _error = $"Could not load messages: {ex.Message}";
        }
    }

    private Task OnServerMessageUpdated(MessageDto message)
    {
        return InvokeAsync(() =>
        {
            Cache.Apply(message);
        });
    }

    private void OnCacheChanged() => InvokeAsync(StateHasChanged);

    private static string FormatState(MessageState state) => state switch
    {
        MessageState.Waiting => "In waiting",
        MessageState.Processed => "Processed",
        MessageState.Deleted => "Deleted",
        _ => state.ToString()
    };

    private static string Truncate(string value, int max) =>
        value.Length <= max ? value : value[..(max - 1)] + "…";

    public void Dispose()
    {
        Cache.Changed -= OnCacheChanged;
        _subscription?.Dispose();
        _subscription = null;
    }
}
