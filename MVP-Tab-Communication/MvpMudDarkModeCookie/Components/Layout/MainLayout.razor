@inherits LayoutComponentBase
@implements IDisposable
@using MvpMudDarkModeCookie.Models
@using MvpMudDarkModeCookie.Services
@inject ThemeService ThemeService

<MudThemeProvider @ref="_themeProvider"
                  @bind-IsDarkMode="_isDarkMode"
                  Theme="_theme"
                  ObserveSystemDarkModeChange="_observeSystem" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Dense="true">
        <MudText Typo="Typo.h6" Class="ml-2">Mud Dark Mode — Cookie</MudText>
        <MudSpacer />
        <ThemeToggle />
    </MudAppBar>
    <MudMainContent Class="pa-4">
        @Body
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private readonly MudTheme _theme = AppTheme.Create();
    private MudThemeProvider? _themeProvider;
    private bool _isDarkMode;
    private bool _observeSystem;
    private bool _systemWatchStarted;

    protected override void OnInitialized()
    {
        ThemeService.InitializeFromCookie();
        SyncFromService();
        ThemeService.Changed += OnThemeServiceChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _themeProvider is null)
        {
            return;
        }

        if (ThemeService.Preference == ThemePreference.System)
        {
            await ResolveSystemPreferenceAsync();
        }
    }

    private async void OnThemeServiceChanged()
    {
        SyncFromService();
        if (ThemeService.Preference == ThemePreference.System)
        {
            await ResolveSystemPreferenceAsync();
        }

        await InvokeAsync(StateHasChanged);
    }

    private void SyncFromService()
    {
        _isDarkMode = ThemeService.IsDarkMode;
        _observeSystem = ThemeService.ObserveSystemDarkModeChange;
    }

    private async Task ResolveSystemPreferenceAsync()
    {
        if (_themeProvider is null)
        {
            return;
        }

        var systemDark = await _themeProvider.GetSystemDarkModeAsync();
        ThemeService.ApplySystemDarkMode(systemDark);
        _isDarkMode = ThemeService.IsDarkMode;
        await EnsureSystemWatchAsync();
    }

    private async Task EnsureSystemWatchAsync()
    {
        if (_systemWatchStarted || _themeProvider is null)
        {
            return;
        }

        _systemWatchStarted = true;
        await _themeProvider.WatchSystemDarkModeAsync(OnSystemDarkModeChangedAsync);
    }

    private Task OnSystemDarkModeChangedAsync(bool isDark)
    {
        ThemeService.ApplySystemDarkMode(isDark);
        return Task.CompletedTask;
    }

    public void Dispose() => ThemeService.Changed -= OnThemeServiceChanged;
}
