<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" rel="stylesheet" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["MvpMudDarkModeCookie.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
    @* Apply background before Blazor/Mud hydrate when cookie says Dark (or System + OS dark). *@
    <script>
        (function () {
            var match = document.cookie.match(/(?:^|; )mud-theme-preference=([^;]*)/);
            var pref = match ? decodeURIComponent(match[1]) : 'System';
            var dark = pref === 'Dark' ||
                (pref === 'System' && window.matchMedia('(prefers-color-scheme: dark)').matches);
            if (dark) {
                document.documentElement.style.backgroundColor = '#121212';
                document.documentElement.classList.add('mud-theme-dark');
            }
        })();
    </script>
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script src="@Assets["js/theme-cookie.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
