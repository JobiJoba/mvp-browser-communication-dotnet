@namespace MvpCaseSidePanelBroadcast.Components.SidePanel
@using MvpCaseSidePanelBroadcast.Models
@using MvpCaseSidePanelBroadcast.Services.DragDrop
@using MvpCaseSidePanelBroadcast.Services.SidePanel
@implements IAsyncDisposable
@inject SidePanelState Panel
@inject DragDropCoordinator Coordinator

<aside class="case-side-panel @(Coordinator.HasRemoteDrag ? "is-active" : null) @(IsDragOver ? "is-over" : null)"
       @ondragover:preventDefault
       @ondragenter="OnDragEnter"
       @ondragleave="OnDragLeave"
       @ondrop:preventDefault
       @ondrop="OnDropAsync">
    <header class="case-side-panel-header">
        <h2>Managed cases</h2>
        <span class="circuit-chip" title="This browser tab id">@ShortTabId</span>
    </header>

    @if (Coordinator.HasRemoteDrag)
    {
        <p class="drop-hint">Drop here to move the case link into this panel</p>
    }

    <div class="case-side-panel-list">
        @foreach (var link in Panel.Links)
        {
            <CaseLinkItem Link="link"
                          DragStarted="OnDragStartedAsync"
                          DragEnded="OnDragEndedAsync"
                          OpenCase="OnOpenCase" />
        }

        @if (Panel.Links.Count == 0)
        {
            <p class="panel-empty">No case links in this panel</p>
        }
    </div>
</aside>

@code {
    private int _enterCount;
    private bool _started;
    private bool IsDragOver => _enterCount > 0;

    private string ShortTabId =>
        string.IsNullOrEmpty(Coordinator.TabId) ? "…" : Coordinator.TabId[..8];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _started)
        {
            return;
        }

        Coordinator.Dispatcher = InvokeAsync;
        Coordinator.Changed += OnChangedAsync;
        Coordinator.LinkRemovedRemotely += OnLinkRemovedAsync;
        Panel.Changed += OnPanelChanged;
        await Coordinator.StartAsync();
        _started = true;
        await InvokeAsync(StateHasChanged);
    }

    private void OnPanelChanged() => _ = InvokeAsync(StateHasChanged);

    private Task OnChangedAsync() => InvokeAsync(StateHasChanged);

    private Task OnLinkRemovedAsync(string caseId)
    {
        Panel.Remove(caseId);
        return InvokeAsync(StateHasChanged);
    }

    private Task OnDragStartedAsync(CaseLink link) =>
        Coordinator.BeginLocalDragAsync(link);

    private Task OnDragEndedAsync() =>
        Coordinator.EndLocalDragAsync();

    private void OnOpenCase(string caseId) =>
        Panel.SelectCase(caseId);

    private void OnDragEnter(DragEventArgs _) => _enterCount++;

    private void OnDragLeave(DragEventArgs _) =>
        _enterCount = Math.Max(0, _enterCount - 1);

    private async Task OnDropAsync(DragEventArgs _)
    {
        _enterCount = 0;

        if (Coordinator.RemoteDrag is { } remote)
        {
            Panel.Add(new CaseLink(remote.Payload.CaseId, remote.Payload.DisplayName));
            await Coordinator.AcceptRemoteDropAsync();
            return;
        }

        if (Coordinator.LocalDrag is not null)
        {
            await Coordinator.AcceptLocalDropAsync();
        }
    }

    public ValueTask DisposeAsync()
    {
        Panel.Changed -= OnPanelChanged;
        Coordinator.Changed -= OnChangedAsync;
        Coordinator.LinkRemovedRemotely -= OnLinkRemovedAsync;
        return ValueTask.CompletedTask;
    }
}
