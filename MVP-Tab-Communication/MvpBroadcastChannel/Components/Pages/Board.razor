@page "/board"
@rendermode InteractiveServer
@using MvpBroadcastChannel.Components.DragDrop
@using MvpBroadcastChannel.Models
@using MvpBroadcastChannel.Services.DragDrop
@implements IAsyncDisposable
@inject DragDropCoordinator Coordinator

<PageTitle>Board — BroadcastChannel</PageTitle>

<section class="board">
    <header class="board-header">
        <div>
            <h1>Cross-window board</h1>
            <p>
                Open this page in a <strong>second browser window</strong> side by side.
                Boxes are shared by id: moving Box A to Inbox in one window updates the other.
                Transport: <code>BroadcastChannel</code> via JSInterop.
            </p>
        </div>
        <div class="board-meta">
            <span class="circuit-id" title="This browser tab id">Tab @ShortTabId</span>
            @if (Coordinator.HasRemoteDrag)
            {
                <span class="status-pill">Remote drag active</span>
            }
        </div>
    </header>

    <div class="board-grid">
        <DropZone ZoneId="tray"
                  Title="Tray"
                  IsActive="Coordinator.HasRemoteDrag"
                  IsEmpty="@(ItemsIn("tray").Count() == 0)"
                  ItemDropped="OnDroppedAsync">
            @foreach (var item in ItemsIn("tray"))
            {
                <Draggable Item="item"
                           DragStarted="OnDragStartedAsync"
                           DragEnded="OnDragEndedAsync" />
            }
        </DropZone>

        <DropZone ZoneId="inbox"
                  Title="Inbox"
                  IsActive="Coordinator.HasRemoteDrag"
                  IsEmpty="@(ItemsIn("inbox").Count() == 0)"
                  ItemDropped="OnDroppedAsync">
            @foreach (var item in ItemsIn("inbox"))
            {
                <Draggable Item="item"
                           DragStarted="OnDragStartedAsync"
                           DragEnded="OnDragEndedAsync" />
            }
        </DropZone>

        <DropZone ZoneId="archive"
                  Title="Archive"
                  IsActive="Coordinator.HasRemoteDrag"
                  IsEmpty="@(ItemsIn("archive").Count() == 0)"
                  ItemDropped="OnDroppedAsync">
            @foreach (var item in ItemsIn("archive"))
            {
                <Draggable Item="item"
                           DragStarted="OnDragStartedAsync"
                           DragEnded="OnDragEndedAsync" />
            }
        </DropZone>
    </div>
</section>

@code {
    // Stable ids so both windows render the same logical boxes.
    private readonly List<BoardItem> _items =
    [
        new("box-a", "Box A", "#c45c26", "tray"),
        new("box-b", "Box B", "#2f6f4e", "tray"),
        new("box-c", "Box C", "#2c5f8a", "tray")
    ];

    private bool _started;

    private string ShortTabId =>
        string.IsNullOrEmpty(Coordinator.TabId) ? "…" : Coordinator.TabId[..8];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _started)
        {
            return;
        }

        Coordinator.Dispatcher = InvokeAsync;
        Coordinator.Changed += OnCoordinatorChangedAsync;
        Coordinator.ItemMoved += OnItemMovedAsync;
        await Coordinator.StartAsync();
        _started = true;
        await InvokeAsync(StateHasChanged);
    }

    private IEnumerable<BoardItem> ItemsIn(string zoneId) =>
        _items.Where(i => i.ZoneId == zoneId);

    private Task OnCoordinatorChangedAsync() => InvokeAsync(StateHasChanged);

    private Task OnItemMovedAsync(string itemId, string zoneId)
    {
        MoveLocal(itemId, zoneId);
        return InvokeAsync(StateHasChanged);
    }

    private Task OnDragStartedAsync(BoardItem item) =>
        Coordinator.BeginLocalDragAsync(item);

    private Task OnDragEndedAsync() =>
        Coordinator.EndLocalDragAsync();

    private async Task OnDroppedAsync(string zoneId)
    {
        if (Coordinator.RemoteDrag is { } remote)
        {
            MoveLocal(remote.Payload.ItemId, zoneId);
            await Coordinator.AcceptRemoteDropAsync(zoneId);
            return;
        }

        if (Coordinator.LocalDrag is { } local)
        {
            MoveLocal(local.Payload.ItemId, zoneId);
            await Coordinator.AcceptLocalDropAsync(zoneId);
        }
    }

    private void MoveLocal(string itemId, string zoneId)
    {
        var index = _items.FindIndex(i => i.Id == itemId);
        if (index < 0)
        {
            return;
        }

        _items[index] = _items[index] with { ZoneId = zoneId };
    }

    public async ValueTask DisposeAsync()
    {
        Coordinator.Changed -= OnCoordinatorChangedAsync;
        Coordinator.ItemMoved -= OnItemMovedAsync;
        await Coordinator.DisposeAsync();
    }
}
